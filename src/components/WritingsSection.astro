---
import { getCollection } from 'astro:content';

const essaysRaw = await getCollection('essays');
const essays = essaysRaw.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

function formatWritingDate(date: Date) {
  const yyyy = date.getFullYear();
  const mm = String(date.getMonth() + 1).padStart(2, '0');
  return `${yyyy} · ${mm}`;
}

function excerptOf(description: string, max = 120) {
  return description.length > max
    ? description.slice(0, max).trimEnd() + '…'
    : description;
}
---

<section id="writings">
  <div class="section-label">
    <span class="sec-num">§ III</span>Technical Essays · System Notes
  </div>
  <div class="writings-head reveal">
    <h2 class="sec-h2">Writings</h2>
    <span class="writings-count">{essays.length} Notes</span>
  </div>
  <p class="body-text reveal">Field notes from 25 years of building. Not optimistic startup essays — architecture reflections, cognitive infrastructure research and technical founder thinking.</p>

  <div class="writings-list reveal">
    {essays.map((essay) => (
      <a href={`/essays/${essay.slug}`} class="writing-entry">
        <div class="writing-date">{formatWritingDate(essay.data.pubDate)}</div>
        <div>
          <div class="writing-title">{essay.data.title}</div>
          <div class="writing-excerpt">{excerptOf(essay.data.description)}</div>
        </div>
        <div class="writing-cat">{essay.data.tags?.[0] ?? ''}</div>
      </a>
    ))}
  </div>
</section>

<style>
.writings-head {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: baseline;
  margin-bottom: 1.5rem;
}
.writings-head .sec-h2 { margin-bottom: 0; }
.writings-count {
  font-family: var(--mono);
  font-size: 0.6rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-4);
}

/* ── WRITINGS LIST (verbatim from jose_vigil_last_design.html) ── */
.writings-list { margin-top: 0.5rem; }

.writing-entry {
  display: grid;
  grid-template-columns: 100px 1fr auto;
  gap: 1.5rem;
  padding: 1.1rem 0;
  border-bottom: 1px solid var(--rule-light);
  align-items: baseline;
  text-decoration: none;
}

.writing-entry:first-child { border-top: 1px solid var(--rule); }

.writing-date {
  font-family: var(--mono);
  font-size: 0.6rem;
  letter-spacing: 0.1em;
  color: var(--ink-4);
  padding-top: 0.2rem;
}

.writing-title {
  font-family: 'EB Garamond', serif;
  font-size: 1rem;
  color: var(--ink);
  line-height: 1.4;
  margin-bottom: 0.25rem;
}

.writing-excerpt {
  font-size: 0.82rem;
  color: var(--ink-3);
  font-style: italic;
  line-height: 1.55;
}

.writing-cat {
  font-family: var(--mono);
  font-size: 0.52rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-4);
  white-space: nowrap;
  align-self: start;
}
</style>
