---
const { data } = Astro.props; // Ensure props are being passed
const pathname = Astro.url?.pathname || "/"; // Fallback for pathname during SSR
---

<!-- Render the custom element -->
<j-quote data-jdata={JSON.stringify(data)} data-pathname={pathname}></j-quote>

<script>
  // Import utility function
  import { getColorFromCollectionName } from "pfunc";

  // Define the custom element
  class JQuote extends HTMLElement {
    constructor() {
      super();

      // Parse data from attributes
      let data = JSON.parse(this.dataset.jdata);
      let pathname = this.dataset.pathname;

      // Extract required fields
      let title = data.title || "Untitled";
      let quote = data.quote || "No quote available";
      let url = "/quotes/quotes/#" + (data.url || "");

      // Get collection name from pathname
      let collection = pathname.split("/")[1] || "default";
      let color = getColorFromCollectionName(collection);

      // Build the HTML template
      let table = `
        <table style="float:center;">
          <tr>
            <td style="vertical-align:top;">
              <h1 style="color:${color}; font-size: 20px;" width="20px">‟</h1>
            </td>
            <td style="padding-left:10px; padding-right:10px;">
              <a id="${data.url}" href="${url}" target="_blank" style="text-decoration: none;">
                <p style="color:${color}; width: 650px; font-size: 20px; text-align: left;">
                  ${quote}&nbsp;&nbsp;<font style="font-size: 10px; color:gray;">Jose Vigil</font>
                </p>
              </a>
            </td>
            <td style="vertical-align:top;">
              <h1 style="color:${color}; font-size: 20px;" width="20px">”</h1>
            </td>
          </tr>
        </table>`;

      // Create a container div
      const div = document.createElement("div");
      div.setAttribute("style", "float:center");
      div.innerHTML = table;

      // Append the content to the custom element
      this.appendChild(div);
    }
  }

  // Define the custom element
  customElements.define("j-quote", JQuote);
</script>
