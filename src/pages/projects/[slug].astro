---
import { getCollection } from 'astro:content';
import MainLayout from '@layouts/MainLayout.astro';
import DisplayTagsDate from '@components/DisplayTagsDate.astro';

import '@styles/article.scss';

export async function getStaticPaths() {

  const pages: any[] = [];

  // Build page of each project
  const projects = await getCollection('projects');
  projects.map((post) => {
    pages.push({
      params: {
        slug: post.slug,
      },
      props: {
        post: post,
      },
    });
  });

  return pages;
}

const post = Astro.props.post;

const { title, description, image, tags, technolgoy, pubDate } = post.data;
const { Content } = await post.render();
---

<MainLayout
  title={`${title} | Jose Vigil`}
  description={description}
  image={image}
>
  <section>
    <div class="section-label">
      <span class="sec-num">§</span>Project
    </div>
    <DisplayTagsDate
      tags={tags}
      technology={technolgoy}
      pubDate={pubDate}
    ></DisplayTagsDate>
    <article class="article-content">
      <Content />
    </article>
  </section>
</MainLayout>
