---
export interface Props {
	title: string;
  description: string;
  image: string;
}

import Head from '@components/Head.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

import '@styles/global.scss';
import '@styles/home.scss';
import '@styles/modal.scss';

const { title, description, image } = Astro.props;
---

<!DOCTYPE html>
<html id="jose" lang="en">
	<Head
    title={title}
    description={description}
    image={image}
  ></Head>
	<body>
    <Header></Header>
    <main>
      <slot />
    </main>
    <Footer></Footer>
	</body>
</html>

<style is:global>
:root {
  /* Editorial "Paper & Ink" palette — extracted from jose_vigil_redesign.html */
  --paper: #f5f0e8;
  --paper-dark: #ede7d9;
  --ink: #1a1612;
  --ink-2: #3d3630;
  --ink-3: #6b6058;
  --ink-4: #a09080;
  --ink-5: #c8bcac;
  --rule: #c0b09a;
  --rule-light: #ddd0bb;
  --red: #8b1a1a;
  --red-2: #c0392b;
  --margin-bg: #ede7d9;
  --col-gap: 2.5rem;
  --serif: 'EB Garamond', 'Libre Baskerville', Georgia, serif;
  --mono: 'DM Mono', 'Courier New', monospace;
  --display: 'Cinzel', serif;

  /* Legacy aliases: global.scss, article.scss y DisplayTagsDate.astro todavia
     referencian --black/--white. Puente temporal hasta migrarlos en una
     etapa posterior a los nombres nuevos. */
  --black: var(--ink);
  --white: var(--paper);
}

*, *::before, *::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background-color: var(--paper);
}
body {
  min-height: 100vh;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--serif);
  font-size: 16px;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
code {
  font-family: var(--mono);
}
main {
  margin: auto;
  padding: 1.5rem;
  max-width: 150ch;
}
</style>
