<style>
.now-head {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: baseline;
  margin-bottom: 1.5rem;
}
.now-head .sec-h2 { margin-bottom: 0; }
.now-sub {
  font-family: var(--mono);
  font-size: 0.6rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-4);
}

/* ── NOW SECTION (verbatim from jose_vigil_last_design.html) ── */
.now-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--col-gap);
  margin-top: 1rem;
}

.now-col h4 {
  font-family: var(--mono);
  font-size: 0.58rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink-4);
  margin-bottom: 1rem;
  border-bottom: 1px solid var(--rule);
  padding-bottom: 0.5rem;
}

.now-list { list-style: none; }

.now-list li {
  font-size: 0.88rem;
  color: var(--ink-2);
  padding: 0.45rem 0;
  border-bottom: 1px solid var(--rule-light);
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  line-height: 1.5;
}

.now-list li::before {
  content: '—';
  color: var(--ink-5);
  font-size: 0.7rem;
  flex-shrink: 0;
}

.now-list li:last-child { border-bottom: none; }

/* ── OPEN POSITIONS ── */
.open-notice {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  padding: 1.25rem 1.5rem;
  border: 1px solid var(--ink);
  margin-top: 2rem;
  background: var(--paper-dark);
}

.open-notice-label {
  font-family: var(--mono);
  font-size: 0.55rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--red);
  white-space: nowrap;
  border-right: 1px solid var(--rule);
  padding-right: 1.5rem;
}

.open-notice-text {
  font-size: 0.85rem;
  color: var(--ink-2);
  line-height: 1.5;
}

.open-notice-text em { font-style: italic; color: var(--ink); }
</style>
